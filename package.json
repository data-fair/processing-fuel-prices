{
  "name": "@data-fair/processing-fuel-prices",
  "version": "1.2.5",
  "description": "Inject fuel prices in France into data-fair datasets",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare": "husky || true",
    "build-types": "export NODE_OPTIONS='--experimental-strip-types' && df-build-types ./config && df-build-types ./types",
    "test-base": "NODE_ENV=test node --experimental-strip-types --test-force-exit --test-concurrency=1 --test --test-reporter=spec --test-reporter-destination=stdout",
    "test": "npm run test-base test-it/*.ts"
  },
  "imports": {
    "#config": "./lib/config.ts",
    "#types/*": "./types/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-fair/processing-fuel-prices.git"
  },
  "keywords": [
    "data-fair-processings-plugin"
  ],
  "author": "Philippe Laidin, Benjamin Giraud-renard",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/data-fair/processing-fuel-prices/issues"
  },
  "homepage": "https://github.com/data-fair/processing-fuel-prices#readme",
  "dependencies": {
    "dayjs": "^1.11.23",
    "fs-extra": "^11.4.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@data-fair/lib-common-types": "^1.24.0",
    "@data-fair/lib-processing-dev": "^0.3.0",
    "@data-fair/lib-types-builder": "^1.14.4",
    "@data-fair/lib-utils": "^1.14.0",
    "@types/fs-extra": "^11.0.4",
    "@types/xml2js": "^0.4.14",
    "axios": "^1.20.0",
    "config": "^4.4.2",
    "debug": "^4.4.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "neostandard": "^0.12.2",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  },
  "files": [
    "processing-config-schema.json",
    "./lib/**/*"
  ]
}
