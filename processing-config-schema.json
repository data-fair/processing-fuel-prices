{
  "type": "object",
  "layout": "tabs",
  "required": ["datasetMode"],
  "allOf": [
    {
      "title": "Jeu de données",
      "default": { "datasetMode": "create", "datasetTitle": "Prix des carburants" },
      "oneOf": [
        {
          "title": "Créer un jeu de données",
          "properties": {
            "datasetMode": { "type": "string", "const": "create", "title": "Action" },
            "datasetTitle": {
              "type": "string",
              "title": "Titre du jeu de données à créer",
              "description": "Le jeu de données est créé lors de la première exécution, le traitement passe ensuite automatiquement en mode mise à jour.",
              "default": "Prix des carburants"
            }
          }
        },
        {
          "title": "Mettre à jour un jeu de données",
          "required": ["dataset"],
          "properties": {
            "datasetMode": { "type": "string", "const": "update", "title": "Action" },
            "dataset": {
              "type": "object",
              "title": "Jeu de données existant",
              "layout": {
                "getItems": {
                  "url": "${context.dataFairUrl}/api/v1/datasets?select=id,title&size=50&${context.ownerFilter}&raw=true",
                  "qSearchParam": "q",
                  "itemsResults": "data.results",
                  "itemTitle": "item.title",
                  "itemKey": "item.id"
                }
              },
              "properties": {
                "id": { "type": "string", "title": "Identifiant" },
                "title": { "type": "string", "title": "Titre" }
              }
            }
          }
        }
      ]
    },
    {
      "title": "Paramètres",
      "properties": {
        "lastSync": {
          "title": "Date de la dernière synchronisation",
          "description": "Renseignée automatiquement après chaque exécution réussie. Seules les lignes mises à jour après cette date sont traitées : indiquer une date plus ancienne pour forcer un rattrapage, ou vider le champ pour revenir à la date de mise à jour du jeu de données.",
          "type": "string"
        }
      }
    }
  ]
}
